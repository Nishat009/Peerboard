PORT=4000
# Comma separated list of web origins allowed to connect
CORS_ORIGINS=http://localhost:3000
# Set to true behind a reverse proxy (Render, Railway) so X-Forwarded-For is trusted
TRUST_PROXY=false

# TURN (optional). Option A: coturn REST API shared secret -> short-lived credentials
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600
# Option B: static provider credentials (e.g. Metered). Still served at runtime, never bundled.
TURN_USERNAME=
TURN_CREDENTIAL=
